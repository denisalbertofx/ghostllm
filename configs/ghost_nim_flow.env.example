# Ghost — flujo NIM + TaskSpec + Planner + Retrieval + Execution Agent (apuesta inicial)
#
# Este archivo es SOLO EJEMPLO (referencia NIM + flags). No se auto-carga.
# Para auto-carga: GHOST_AUTOLOAD_ENV=1 + .ghost.env o configs/ghost.local.env
#   Plantilla loadable: configs/ghost.local.env.example → copiar a configs/ghost.local.env
#
# IMPORTANTE: Ghost no lee este archivo solo. Antes de `ghost dev`, carga las vars en la sesión, p. ej.:
#   Get-Content configs/ghost_nim_flow.env.example | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]+)=(.*)$') { Set-Item -Path "env:$($matches[1].Trim())" -Value $matches[2].Trim() }
#   }
# (Ignora líneas que empiezan por #; valores con espacios raros pueden romper el parseo.)
#
# Modelos por defecto en código (no hace falta definirlos si coinciden):
#   Planner / Execution / Repair / Fallback: qwen/qwen3-coder-480b-a35b-instruct

GHOST_USE_TASKSPEC=1
GHOST_USE_DECISION_PLANNER=1
GHOST_USE_RETRIEVAL=1
# GHOST_RETRIEVAL_INFLUENCES_RUNTIME=0

GHOST_USE_EXECUTION_AGENT=1
GHOST_EXECUTION_AGENT_LIVE=1
GHOST_EXECUTION_AGENT_WRITES=0

GHOST_USE_NVIDIA_NIM=1
GHOST_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
GHOST_NIM_API_KEY=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
GHOST_NIM_TIMEOUT_SECONDS=120

# Opcionales (defaults = stack canónico de coding)
GHOST_PLANNER_MODEL=qwen/qwen3-coder-480b-a35b-instruct
GHOST_EXECUTION_MODEL=qwen/qwen3-coder-480b-a35b-instruct
GHOST_REPAIR_MODEL=qwen/qwen3-coder-480b-a35b-instruct
GHOST_GENERAL_FALLBACK_MODEL=qwen/qwen3-coder-480b-a35b-instruct
# GHOST_EXECUTION_FALLBACK_MODEL=   (vacío => mismo que general fallback; dejar comentado o sin valor)

# Batch tool loop + compresión de aprobaciones (Sprint 1; 0 = comportamiento previo)
GHOST_USE_BATCH_EXECUTOR=1
GHOST_USE_APPROVAL_COMPRESSION=1
