# Plantilla para configuración LOCAL cargable por Ghost (copiar a uno de los rutas abajo).
# NO es un ejemplo “solo lectura” como ghost_nim_flow.env.example: este archivo sirve de base
# para crear tu copia real.
#
# Archivos que Ghost puede auto-cargar si GHOST_AUTOLOAD_ENV=1 (en el ENTORNO, no dentro de este archivo):
#   1) .ghost.env          (en la raíz del repo donde ejecutas ghost dev)
#   2) configs/ghost.local.env
#
# Precedencia: variables ya definidas en la shell / sistema NO se sobrescriben.
#
# Pasos:
#   copy configs\ghost.local.env.example configs\ghost.local.env
#   $env:GHOST_AUTOLOAD_ENV = "1"
#   ghost dev

# GHOST_USE_TASKSPEC=1
# GHOST_USE_DECISION_PLANNER=1
# GHOST_USE_RETRIEVAL=1
# GHOST_USE_BATCH_EXECUTOR=1
# GHOST_USE_APPROVAL_COMPRESSION=1
# GHOST_USE_NVIDIA_NIM=1
